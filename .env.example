# Ambiente bajo prueba. Por defecto usa el banco demo local.
BASE_URL=http://127.0.0.1:4010
API_URL=http://127.0.0.1:4010/api

# Credenciales del ambiente de PRUEBAS. Nunca credenciales reales de produccion.
USUARIO_QA=cmartinez
CLAVE_QA=Prueba2026*

# Pruebas de carga: hosts autorizados explicitamente (separados por coma).
# El runner se niega a generar carga contra cualquier host fuera de esta lista.
LOAD_ALLOWED_HOSTS=127.0.0.1,localhost

# Opcional: usar un Chromium ya instalado en vez del que descarga Playwright.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
